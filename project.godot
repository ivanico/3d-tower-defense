; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TowersLastStand3D"
run/main_scene="res://scenes/ui/world_map.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

Constants="*res://autoloads/constants.gd"
EventBus="*res://autoloads/event_bus.gd"
GameState="*res://autoloads/game_state.gd"
MetaManager="*res://autoloads/meta_manager.gd"
SpellRegistry="*res://autoloads/spell_registry.gd"
TowerRegistry="*res://autoloads/tower_registry.gd"
ObjectPool="*res://autoloads/object_pool.gd"
AudioManager="*res://autoloads/audio_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=662
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/ui_icon_cap/plugin.cfg")

[gui]

theme/custom="res://resources/theme/ui_theme.tres"

[logging]

; Every print() (all the DEBUGTEST lines included) now persists to disk
; automatically, every run, instead of vanishing when the console/window
; closes -- see user://logs dir (Windows:
; %APPDATA%\Godot\app_userdata\TowersLastStand3D\logs\). max_log_files=1
; means only the most recent run's log is kept -- each new run overwrites
; the last one, so it never grows unbounded.
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/game.log"
file_logging/max_log_files=1

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
