; Uses the *1* variant of the gem: its artwork fills 83.1% x 81.2% of the canvas
; where the plain one fills only 57.4% x 56.2%, so it needs far less scaling up.
; icon_scale 0.82 makes the gem's drawn height 0.812 x 0.82 x 124 = 83px, matching
; the bolt's 0.670 x 124 = 83px, so the two icons read as the same size.
[node name="MaterialsPill" parent="." instance=ExtResource("1")]
icon = ExtResource("3")
icon_scale = 0.82
amount = 999
