[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/widget/tower_preview_3d/tower_preview_3d.gd" id="0"]

; background_mode MUST stay 0 (BG_CLEAR_COLOR). It was 4 (BG_KEEP), which tells
; the renderer not to clear the target between frames — on a transparent_bg
; SubViewport that leaves uninitialised GPU memory on screen, which showed up as
; a rectangle of coloured static behind the tower. BG_CLEAR_COLOR still honours
; transparent_bg, so the garage background shows through as intended.
[sub_resource type="Environment" id="env"]
background_mode = 0
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.45, 0.65, 1)
ambient_light_energy = 0.45
tonemap_mode = 2

; own_world_3d is what keeps this preview's camera, lights and environment
; entirely separate from the gameplay world. transparent_bg lets the garage
; background show through behind the model.
;
; The model itself is instanced under ModelRoot at runtime from the raw .glb —
; NOT from the tower's gameplay scene, which would start a run. See the script.

[node name="TowerPreview3D" type="Control"]
offset_right = 900.0
offset_bottom = 760.0
mouse_filter = 2
script = ExtResource("0")

[node name="SubViewportContainer" type="SubViewportContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
stretch = true

[node name="SubViewport" type="SubViewport" parent="SubViewportContainer"]
own_world_3d = true
transparent_bg = true
handle_input_locally = false
size = Vector2i(900, 760)
render_target_update_mode = 4

[node name="Camera3D" type="Camera3D" parent="SubViewportContainer/SubViewport"]
fov = 40.0

[node name="KeyLight" type="DirectionalLight3D" parent="SubViewportContainer/SubViewport"]
light_energy = 1.9

[node name="FillLight" type="DirectionalLight3D" parent="SubViewportContainer/SubViewport"]
light_energy = 0.8

[node name="WorldEnvironment" type="WorldEnvironment" parent="SubViewportContainer/SubViewport"]
environment = SubResource("env")

[node name="ModelRoot" type="Node3D" parent="SubViewportContainer/SubViewport"]
