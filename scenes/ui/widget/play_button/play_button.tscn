; Both children use size_flags_vertical 4 (SHRINK_CENTER) so each is centred on
; the row's centre line — that is what puts "x1" level with the middle of the
; bolt rather than sitting on the row baseline.

[node name="Icon" type="TextureRect" parent="Content/CostRow"]
